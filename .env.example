# 复制为 .env 后必须填写下面三个空值；留空时 Compose 会拒绝启动。
# 不要把填有真实密码或密钥的 .env 提交到 Git。
MYSQL_ROOT_PASSWORD=
MYSQL_APP_PASSWORD=
ZIJING_JWT_SECRET=

APP_PORT=8080
MYSQL_PORT=3306
MYSQL_DATABASE=rebuilt_zijing_forum
MYSQL_APP_USER=forum

# 图片默认保存在 Docker volume；切换 OSS 时改为 oss 并填写全部 OSS 配置。
FORUM_STORAGE_TYPE=local
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_REGION=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_PUBLIC_BASE_URL=

# 论坛正式 AI 搜索，默认关闭。
FORUM_AI_ENABLED=false
FORUM_AI_API_KEY=
FORUM_AI_MODEL=deepseek-chat

# 独立 LangChain4j 学习页，默认关闭并使用独立密钥。
FORUM_LEARNING_AI_ENABLED=false
FORUM_LEARNING_AI_API_KEY=
FORUM_LEARNING_AI_MODEL=deepseek-flash

# 可选中间件必须同时启用 Compose profile 和对应功能开关。
FORUM_REDIS_ENABLED=false
FORUM_RABBIT_ENABLED=false
FORUM_ES_ENABLED=false
RABBITMQ_USERNAME=forum
RABBITMQ_PASSWORD=
